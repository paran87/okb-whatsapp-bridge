# OKB WhatsApp Bridge — reference backend configuration (copy to .env; never commit real values)

# --- Server ---
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data

# Comma-separated bearer tokens the backend accepts from devices. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OKB_DEVICE_TOKENS=replace-with-a-long-random-token

# DEVELOPMENT ONLY: set to 1 to accept requests with no token. Never enable in production.
# OKB_ALLOW_NO_AUTH=1

# Local-sink blob size cap in bytes (dev media mode only). Default 2 GiB.
# OKB_MAX_MEDIA_BYTES=2147483648

# Bearer tokens for the flood-report endpoints (/api/v1/reports...): listing, review, retry.
# Recommended: a separate token for operators so devices cannot approve reports.
# When unset, the device tokens above are accepted there as well.
# OKB_ADMIN_TOKENS=replace-with-a-different-long-random-token

# --- Cloudflare R2 (optional) ---
# When ALL four are set, media uploads are presigned directly to R2 (the device never sees these).
# When any is missing, the backend uses the DEV local-sink instead (stores media under DATA_DIR/media).
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Flood-report extraction (Phase 3, optional) ---
# Server-side only: the key is never sent to the phone. Without AI_API_KEY, messages are still stored and
# obvious non-reports (system notifications, greetings) are still filtered; everything else waits in
# status "received" until AI is configured (it is picked up automatically on the next start).
AI_API_KEY=
# AI_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-opus-5-5
# Per-attempt timeout in milliseconds, and retries after the first attempt (bounded; no endless retries).
# AI_TIMEOUT_MS=120000
# AI_MAX_RETRIES=2
# Set to 0 to stop processing new messages automatically (use POST /api/v1/reports/process instead).
# OKB_REPORT_AUTO_PROCESS=1
